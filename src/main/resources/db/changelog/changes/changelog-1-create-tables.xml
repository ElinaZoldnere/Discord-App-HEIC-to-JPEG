<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                     http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.8.xsd">

    <changeSet author="elina.zoldnere DiscordApp" id="1">
        <createTable tableName="users">
            <column autoIncrement="true" name="id" type="BIGINT">
                <constraints primaryKey="true"/>
            </column>
            <column name="user_discord_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="description" type="VARCHAR(100)"/>
        </createTable>
    </changeSet>

    <changeSet author="elina.zoldnere DiscordApp" id="2">
        <createTable tableName="dates">
            <column autoIncrement="true" name="id" type="BIGINT">
                <constraints primaryKey="true"/>
            </column>
            <column name="date" type="DATE">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <createIndex indexName="ix_dates_date"
                     tableName="dates">
            <column name="date"/>
        </createIndex>
    </changeSet>

    <changeSet author="elina.zoldnere DiscordApp" id="3">
        <createTable tableName="birthdays">
            <column autoIncrement="true" name="id" type="BIGINT">
                <constraints primaryKey="true"/>
            </column>
            <column name="user_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="date_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="description" type="VARCHAR(100)"/>
        </createTable>

        <addForeignKeyConstraint baseColumnNames="user_id"
                                 baseTableName="birthdays"
                                 constraintName="fk_birthdays_user_id"
                                 referencedColumnNames="id"
                                 referencedTableName="users"/>

        <addForeignKeyConstraint baseColumnNames="date_id"
                                 baseTableName="birthdays"
                                 constraintName="fk_birthdays_date_id"
                                 referencedColumnNames="id"
                                 referencedTableName="dates"/>

        <createIndex indexName="ix_birthdays_date_id"
                     tableName="birthdays">
            <column name="date_id"/>
        </createIndex>
    </changeSet>

    <changeSet author="elina.zoldnere DiscordApp" id="4">
        <createTable tableName="name_days">
            <column autoIncrement="true" name="id" type="BIGINT">
                <constraints primaryKey="true"/>
            </column>
            <column name="user_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="date_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="description" type="VARCHAR(100)"/>
        </createTable>

        <addForeignKeyConstraint baseColumnNames="user_id"
                                 baseTableName="name_days"
                                 constraintName="fk_name_days_user_id"
                                 referencedColumnNames="id"
                                 referencedTableName="users"/>

        <addForeignKeyConstraint baseColumnNames="date_id"
                                 baseTableName="name_days"
                                 constraintName="fk_name_days_date_id"
                                 referencedColumnNames="id"
                                 referencedTableName="dates"/>

        <createIndex indexName="ix_name_days_date_id"
                     tableName="name_days">
                <column name="date_id"/>
        </createIndex>
    </changeSet>
</databaseChangeLog>
