# Replace the values with your own

# Token for the Discord bot (replace with your bot's token)
DISCORD_BOT_TOKEN=your_discord_bot_token

# ID of the bot owner (replace with your Discord user ID)
OWNER_ID=your_owner_id

# URL of the cloud function endpoint
CLOUD_FUNCTION_URL=your_cloud_function_url

# Secret token for verification/authentication
SECRET_TOKEN=your_secret_token
